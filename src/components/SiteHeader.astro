---
import Icon from './Icon.astro';
import ThemeControl from './ThemeControl.astro';
import { MORE_NAV, PRIMARY_NAV, SITE } from '../lib/site';
import { href, isWithin } from '../lib/url';

const pathname = Astro.url.pathname;
const withState = (items: typeof PRIMARY_NAV) =>
  items.map((item) => ({
    ...item,
    url: href(item.path),
    exact: pathname === href(item.path),
    // Home is current only on itself; a section is current anywhere inside it.
    current: item.path === '' ? pathname === href() : isWithin(pathname, item.path),
  }));
const nav = withState(PRIMARY_NAV);
const more = withState(MORE_NAV);
const moreCurrent = more.some((item) => item.current);
const ariaCurrent = (item: { exact: boolean; current: boolean }) =>
  item.exact ? 'page' : item.current ? 'true' : undefined;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={href()}>
      <img src={href('favicon.svg')} width="28" height="28" alt="" />
      <span>RadMage <span class="brand__accent">Finance</span></span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.url} aria-current={ariaCurrent(item)}>{item.label}</a></li>
        ))}
        <li>
          <details class="more-menu" data-more-menu>
            <summary class:list={{ 'is-current': moreCurrent }}>
              More<Icon name="chevron" />
            </summary>
            <div class="more-menu__panel">
              <ul>
                {more.map((item) => (
                  <li><a href={item.url} aria-current={ariaCurrent(item)}>{item.label}</a></li>
                ))}
              </ul>
              <p class="more-menu__foot">
                <a href={SITE.publisherUrl}>RadMage Labs home</a>
              </p>
            </div>
          </details>
        </li>
      </ul>
    </nav>

    <div class="header-tools">
      <ThemeControl id="header" compact />
      <button
        class="menu-button"
        type="button"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-open
      >
        <Icon name="menu" />
        <span>Menu</span>
      </button>
    </div>
  </div>
</header>

<dialog id="site-menu" class="menu-dialog" aria-labelledby="site-menu-title">
  <div class="menu-dialog__inner">
    <div class="menu-dialog__head">
      <h2 class="menu-dialog__title" id="site-menu-title">Menu</h2>
      <button class="icon-button" type="button" data-menu-close aria-label="Close menu">
        <Icon name="close" />
      </button>
    </div>

    <nav class="menu-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.url} aria-current={ariaCurrent(item)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="menu-nav menu-nav--secondary" aria-labelledby="menu-more-title">
      <p class="menu-section-title" id="menu-more-title">More</p>
      <ul>
        {more.map((item) => (
          <li><a href={item.url} aria-current={ariaCurrent(item)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <p class="menu-section-title" aria-hidden="true">Theme</p>
      <ThemeControl id="menu" />
    </div>

    <div class="menu-dialog__foot">
      <a href={SITE.publisherUrl}>RadMage Labs home</a>
    </div>
  </div>
</dialog>

<script>
  import '../scripts/menu';
</script>
