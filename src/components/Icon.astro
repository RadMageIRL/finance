---
// Small inline icons. Decorative only: the text next to them carries the meaning.
interface Props {
  name: 'moon' | 'sun' | 'system' | 'menu' | 'close' | 'chevron';
}
const { name } = Astro.props;
---
<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
  {name === 'moon' && (
    <path fill="currentColor" d="M6.2 1.2a6.9 6.9 0 1 0 8.6 8.6A5.6 5.6 0 0 1 6.2 1.2z" />
  )}
  {name === 'sun' && (
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <circle cx="8" cy="8" r="3" fill="currentColor" stroke="none" />
      <path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M3.05 12.95l1.13-1.13M11.82 4.18l1.13-1.13" />
    </g>
  )}
  {name === 'system' && (
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
      <rect x="1.5" y="2.5" width="13" height="9" rx="1.5" />
      <path d="M5.5 14h5M8 11.5V14" stroke-linecap="round" />
      <path d="M8 2.5v9h5.75a.75.75 0 0 0 .75-.75V4a1.5 1.5 0 0 0-1.5-1.5z" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === 'menu' && (
    <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="M2 4h12M2 8h12M2 12h12" />
  )}
  {name === 'chevron' && (
    <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M4 6l4 4 4-4" />
  )}
  {name === 'close' && (
    <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="M3.5 3.5l9 9M12.5 3.5l-9 9" />
  )}
</svg>
