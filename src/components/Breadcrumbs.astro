---
import { SITE } from '../lib/site';
import { href } from '../lib/url';

export interface Crumb {
  label: string;
  path?: string;
}

interface Props {
  /** Ancestors of the current page, Home first. The current page is the last item. */
  items: Crumb[];
}

const { items } = Astro.props;
// The same trail as structured data (schema.org BreadcrumbList); the last item is this page.
const trail = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(index === items.length - 1 ? Astro.url.pathname : href(item.path ?? ''), SITE.origin).href,
  })),
};
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, index) => (
      <li>
        {index === items.length - 1 || item.path === undefined
          ? <span aria-current={index === items.length - 1 ? 'page' : undefined}>{item.label}</span>
          : <a href={href(item.path)}>{item.label}</a>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" is:inline set:html={JSON.stringify(trail)} />
