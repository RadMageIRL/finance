---
import { FOOTER_GROUPS, SITE } from '../lib/site';
import { newsIndexing } from '../lib/news-index';
import SupportLinks from './SupportLinks.astro';
import { href } from '../lib/url';

const newsLive = newsIndexing().any;
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-about">
      <a class="brand" href={href()}>
        <img src={href('favicon.svg')} width="28" height="28" alt="" />
        <span>RadMage <span class="brand__accent">Finance</span></span>
      </a>
      <p>Free lessons and calculators that show how money, banking and interest work. Sources linked, formulas shown, calculations done in your browser. {newsLive ? 'Financial news from official sources, linked to the publishers.' : 'Financial news is in development.'}</p>
      <p>Educational information, not financial advice. <a href={href('disclaimer/')}>Read the disclaimer</a>.</p>
      <SupportLinks />
    </div>
    {FOOTER_GROUPS.map((group, index) => (
      <nav aria-labelledby={`footer-group-${index}`}>
        <h2 class="footer-title" id={`footer-group-${index}`}>{group.title}</h2>
        <ul>
          {group.items.map((item) => (
            <li><a href={href(item.path)}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="wrap footer-base">
    <p>Published by <a href={SITE.publisherUrl}>{SITE.publisher}</a>.</p>
    <p>Free to use. No account, no cookies, no tracking.</p>
  </div>
</footer>
