---
// The economic data entry of the site header (decision D15 (b)): in the More menu, apart from the
// reference pages, and as its own section of the phone menu. SiteHeader imports it only when the
// data pages are built (DATA_PAGES=on; owner brief R, option (b); rule D5 of
// src/lib/data/shell-dist.ts), so a build with the pages held has neither this markup nor its styles.
interface Props {
  where: 'more' | 'menu';
  url: string;
  label: string;
  ariaCurrent: 'page' | 'true' | undefined;
}

const { where, url, label, ariaCurrent } = Astro.props;
---
{where === 'more' ? (
  <div class="more-menu__data">
    <a href={url} aria-current={ariaCurrent}>{label}</a>
  </div>
) : (
  <nav class="menu-nav menu-nav--data" aria-labelledby="menu-data-title">
    <p class="menu-section-title" id="menu-data-title">Data</p>
    <ul>
      <li><a href={url} aria-current={ariaCurrent}>{label}</a></li>
    </ul>
  </nav>
)}

<style>
  /* The economic data entry sits apart from the reference pages in the More menu. */
  .more-menu__data {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
  }

  .menu-nav--data a {
    padding-block: var(--space-2);
    font-size: var(--step-0);
  }
</style>
