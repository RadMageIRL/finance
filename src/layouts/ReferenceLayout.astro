---
// Long-form reference pages: About, Methodology, Sources, Corrections, Privacy, Disclaimer.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  lead: string;
  /** ISO date the text was last reviewed. */
  updated: string;
  schemaType?: 'WebPage' | 'AboutPage';
}

const { title, description, lead, updated, schemaType = 'WebPage' } = Astro.props;
const updatedLabel = new Date(`${updated}T12:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---
<BaseLayout title={title} description={description} schemaType={schemaType}>
  <div class="page-head">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', path: '' }, { label: title }]} />
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      <p class="page-meta">Last updated <time datetime={updated}>{updatedLabel}</time></p>
    </div>
  </div>
  <div class="wrap page-body">
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
