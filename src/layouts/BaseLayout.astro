---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/news.css';
import '../styles/calc.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { HEAD_SCRIPT } from '../lib/theme/head-script.mjs';
import { SITE } from '../lib/site';
import { href } from '../lib/url';

interface Props {
  /** Page name without the site name; the site name is appended. */
  title: string;
  description: string;
  /** Review and error pages that should not be indexed. */
  noindex?: boolean;
  /** schema.org type for the page. */
  schemaType?: 'WebPage' | 'WebSite' | 'AboutPage' | 'CollectionPage' | 'LearningResource' | 'WebApplication';
  /** More schema.org properties for this page's type, for example the review date. */
  schema?: Record<string, unknown>;
  /** Open Graph image under public/og/, without the extension. */
  image?: string;
  /** What the Open Graph image shows, for its alt text. */
  imageAlt?: string;
}

const { title, description, noindex = false, schemaType = 'WebPage', schema = {}, image = 'default', imageAlt } = Astro.props;
const imageUrl = new URL(href(`og/${image}.png`), Astro.site).href;
const isHome = Astro.url.pathname === href();
const fullTitle = isHome ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const publisher = {
  '@type': 'Organization',
  name: SITE.publisher,
  url: SITE.publisherUrl,
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: isHome ? SITE.name : title,
  description,
  url: canonical,
  inLanguage: 'en-US',
  publisher,
  image: imageUrl,
  ...(schemaType === 'WebSite' ? {} : { isPartOf: { '@type': 'WebSite', name: SITE.name, url: new URL(href(), Astro.site).href } }),
  ...schema,
};
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={HEAD_SCRIPT} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#10151f" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? `${title}, RadMage Finance`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/theme';
    </script>
  </body>
</html>
