---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogCard from '../components/CatalogCard.astro';
import ClaimLabel from '../components/ClaimLabel.astro';
import { CALCULATORS, MODULES, NEWS_CATEGORIES, SITE } from '../lib/site';
import { href } from '../lib/url';
---
<BaseLayout
  title="RadMage Finance: How Money Works, Shown Step by Step"
  description={SITE.description}
  schemaType="WebSite"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <p class="eyebrow">Free financial education</p>
      <h1 id="hero-title">How money works, shown step by step.</h1>
      <p class="lead">
        Interactive lessons and calculators that show their math, for savers, borrowers,
        homeowners and anyone curious about the financial system. Every fact links to its
        source, and every calculation runs in your browser. Source-linked financial news is
        in development.
      </p>
      <div class="button-row">
        <a class="button" href={href('learn/')}>Start learning</a>
        <a class="button button--secondary" href={href('calculators/')}>Open the calculators</a>
      </div>
    </div>
  </section>

  <section class="section news-home" aria-labelledby="news-title">
    <div class="wrap news-panel">
      <div class="news-panel__intro">
        <div class="news-panel__heading">
          <h2 id="news-title">Financial News</h2>
          <span class="badge badge--preview">Preview</span>
        </div>
        <p>
          In development: headlines from named publishers, grouped by topic and linked to the
          original reporting, with publication times and refresh status shown on every page.
        </p>
        <p class="small muted">News is in development. Feeds are not live yet, so no stories are shown.</p>
        <a class="button button--secondary" href={href('news/')}>Preview the News section</a>
      </div>
      <ul class="topic-grid">
        {NEWS_CATEGORIES.map((category) => (
          <li>
            <a class="topic-tile" href={href(`news/#${category.id}`)}>
              <span class="topic-tile__label">{category.label}</span>
              <span class="topic-tile__scope">{category.scope}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="learn-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="learn-title">Learn</h2>
        <p>Interactive lessons with balance sheets that always balance.</p>
      </div>
      <ul class="card-grid card-grid--wide">
        {MODULES.map((item, index) => (
          <li><CatalogCard item={item} index={index + 1} feature /></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="calculators-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="calculators-title">Calculators</h2>
        <p>Savings, interest and loans, with the math and assumptions in plain view.</p>
      </div>
      <ul class="card-grid">
        {CALCULATORS.map((item) => (
          <li><CatalogCard item={item} /></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="how-title">How this site works</h2>
        <p><a href={href('methodology/')}>Read the methodology</a></p>
      </div>
      <ul class="principles">
        <li>
          <h3>Sources you can check</h3>
          <p>Facts link to their source, preferably the law, regulation or official data itself, with the date they were last verified.</p>
        </li>
        <li>
          <h3>Every claim labeled</h3>
          <p>Statements say what kind of claim they are, so a teaching model is never mistaken for a fact, or a calculator's projection for a forecast.</p>
          <div class="claim-row">
            <ClaimLabel kind="fact" />
            <ClaimLabel kind="identity" />
            <ClaimLabel kind="model" />
            <ClaimLabel kind="interpretation" />
            <ClaimLabel kind="projection" />
            <ClaimLabel kind="forecast" />
          </div>
        </li>
        <li>
          <h3>Private by design</h3>
          <p>No account and no tracking. Calculators run on your device, and the numbers you enter are never sent anywhere.</p>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
