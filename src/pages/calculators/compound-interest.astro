---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ClaimLabel from '../../components/ClaimLabel.astro';
import CalcChoice from '../../components/calc/CalcChoice.astro';
import CalcField from '../../components/calc/CalcField.astro';
import CalcSelect from '../../components/calc/CalcSelect.astro';
import ScheduleView from '../../components/calc/ScheduleView.astro';
import ShareExport from '../../components/calc/ShareExport.astro';
import { compoundInterest } from '../../lib/engines/compound';
import { COMPOUND_ASSUMPTIONS, DEFAULT_INPUT, FREQUENCIES, SERIES, compoundChartSvg, compoundSchedule, compoundScheduleConfig, compoundScheduleNotes, compoundView } from '../../lib/calc/compound-view';
import { scheduleTable } from '../../lib/calc/schedule-view';
import { CONTRIBUTION_OPTIONS, contributionHint, contributionOption } from '../../lib/calc/frequency';
import { calculatorSchema } from '../../lib/site';
import { href } from '../../lib/url';
import '../../styles/report.css';

// The example scenario is computed at build time with the same engine and view code the
// browser uses, so the page shows real results even without JavaScript.
const computed = compoundInterest(DEFAULT_INPUT);
if (!computed.ok) throw new Error('compound interest example scenario is invalid');
const view = compoundView(DEFAULT_INPUT, computed.value);
const schedule = compoundSchedule(DEFAULT_INPUT, computed.value);
const table = scheduleTable(schedule, 'year', compoundScheduleConfig(DEFAULT_INPUT));
const chartSvg = compoundChartSvg(DEFAULT_INPUT, schedule, 'year', view.summary);
const interval = contributionOption(DEFAULT_INPUT.contributionFrequency).interval;
---
<BaseLayout
  schemaType="WebApplication"
  schema={calculatorSchema()}
  image="calc-compound-interest"
  title="Compound Interest Calculator"
  description="See how a balance grows when interest earns interest, with any compounding frequency and weekly, monthly or other regular contributions. Year-by-year table, chart and CSV, calculated in your browser."
>
  <div class="page-head">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', path: '' }, { label: 'Calculators', path: 'calculators/' }, { label: 'Compound interest' }]} />
      <h1>Compound interest calculator</h1>
      <p class="lead">
        See how a balance grows when interest earns interest, and how much of the result comes
        from what you put in versus the interest itself.
      </p>
    </div>
  </div>

  <div class="wrap page-body">
    <div class="calc" data-calc="compound" data-state="ok">
      <form class="calc__inputs" novalidate aria-labelledby="ci-inputs-title">
        <h2 class="calc__heading" id="ci-inputs-title">Your scenario</h2>
        <p class="calc__note" data-out="shared-note" hidden></p>
        <CalcField id="ci-principal" label="Starting balance" unitLabel="in dollars" kind="money" value="10,000.00" hint="The amount in the account on day one." />
        <CalcField id="ci-rate" label="Annual interest rate" unitLabel="in percent" kind="percent" value="5" hint="The yearly rate before compounding, for example 4.5." />
        <CalcSelect id="ci-frequency" label="Compounding" value={String(DEFAULT_INPUT.periodsPerYear)} options={FREQUENCIES.map((f) => ({ value: String(f.value), label: f.label }))} hint="How often interest is credited and starts earning interest itself." />
        <CalcField id="ci-years" label="Years" kind="whole" value="10" hint="From 1 to 100." />
        <CalcSelect id="ci-contribution-frequency" label="Contribution frequency" value={DEFAULT_INPUT.contributionFrequency} options={CONTRIBUTION_OPTIONS.map((o) => ({ value: o.value, label: o.label }))} hint="How often you add money. This is separate from compounding." />
        <div data-contribution>
          <CalcField id="ci-contribution" label="Contribution amount" unitLabel="in dollars" kind="money" value="100.00" hint={contributionHint(DEFAULT_INPUT.contributionFrequency, DEFAULT_INPUT.timing)} />
        </div>
        <div data-contribution>
          <CalcChoice name="ci-timing" legend="Contribution timing" value={DEFAULT_INPUT.timing} options={[{ value: 'end', label: `End of each ${interval}` }, { value: 'start', label: `Start of each ${interval}` }]} />
        </div>
        <p class="calc__nojs small muted">This calculator needs JavaScript to recalculate. Without it, the results show the example scenario above.</p>
      </form>

      <section class="calc__results" aria-labelledby="ci-results-title">
        <div class="calc__results-head">
          <h2 class="calc__heading" id="ci-results-title">Projected balance</h2>
          <ClaimLabel kind="forecast" />
        </div>
        <div class="calc__values">
          <p class="calc__hero" data-out="final">{view.final}</p>
          <dl class="breakdown">
            <div><dt>Starting balance</dt><dd data-out="principal">{view.breakdown[0]!.value}</dd></div>
            <div><dt>Contributions</dt><dd data-out="contributions">{view.breakdown[1]!.value}</dd></div>
            <div><dt>Interest earned</dt><dd data-out="interest">{view.breakdown[2]!.value}</dd></div>
            <div class="breakdown__total"><dt>Final balance</dt><dd data-out="final-again">{view.final}</dd></div>
          </dl>
          <p class="calc__summary" data-out="summary">{view.summary}</p>
        </div>
        <p class="calc__invalid" data-out="invalid">Results are hidden until the highlighted entries are fixed.</p>
        <p class="calc__incomplete" data-out="incomplete">Enter your own dollar amounts to see results.</p>
        <p class="vh" data-out="status" role="status" aria-live="polite"></p>
        <ShareExport idPrefix="ci" dayLimit />
        <p class="small muted">A hypothetical projection, not a prediction. Real rates change. <a href={href('disclaimer/')}>Disclaimer</a>.</p>
      </section>
    </div>

    <div class="calc-sticky" data-sticky aria-hidden="true">
      <span>Projected balance</span>
      <strong data-out="final-sticky">{view.final}</strong>
    </div>

    <ScheduleView id="ci-schedule" heading="Balance and schedule" series={SERIES} svg={chartSvg} table={table} notes={compoundScheduleNotes(DEFAULT_INPUT, 'year')} chartHelp="the balance" />

    <div class="prose calc-notes">
      <h2>Assumptions</h2>
      <ul>
        {COMPOUND_ASSUMPTIONS.map((a) => <li>{a}</li>)}
      </ul>

      <h2>How this is calculated</h2>
      <p>
        Each compounding period, the balance earns the annual rate divided by the number of
        compounding periods in a year. If contributions arrive during the period, that rate is
        applied to the period's average daily balance, so each contribution earns interest
        only for the days it was in the account. The interest is rounded to the cent and added
        to the balance, so the next period's interest is earned on it too: interest earning
        interest. The calculator repeats this period by period, the way an account is credited.
      </p>
      <p>
        When there is one contribution per compounding period (for example monthly
        contributions with monthly compounding), the textbook formula gives nearly the same
        result in one step:
      </p>
      <p class="formula">
        <code>FV = P(1 + r/n)<sup>nt</sup> + C × [(1 + r/n)<sup>nt</sup> − 1] / (r/n)</code>
      </p>
      <p>
        where P is the starting balance, r the annual rate, n the compounding periods per year,
        t the years and C the contribution each period. For contributions at the start of each
        period, the contribution term is multiplied by (1 + r/n). The formula never rounds, so it
        can differ from the period-by-period result by a few cents. When contributions and
        compounding follow different schedules, no single formula applies, and the calculator
        adds each contribution on its own date.
      </p>
      <p>
        This is the textbook model. A bank figures savings interest a little differently: with
        a daily rate of 1/365 of the interest rate on each day's balance, so a 31-day month
        earns slightly more than a 28-day one. The <a href={href('calculators/savings-growth/')}>high-yield savings calculator</a> works
        that way, starting from the APY a bank advertises.
      </p>
      <p>
        The calculation is checked against an independent implementation that uses exact
        decimal arithmetic. See the <a href={href('methodology/')}>Methodology</a>.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/calc/compound';
</script>
