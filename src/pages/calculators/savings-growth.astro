---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ClaimLabel from '../../components/ClaimLabel.astro';
import CalcChoice from '../../components/calc/CalcChoice.astro';
import CalcField from '../../components/calc/CalcField.astro';
import CalcSelect from '../../components/calc/CalcSelect.astro';
import ScheduleView from '../../components/calc/ScheduleView.astro';
import ShareExport from '../../components/calc/ShareExport.astro';
import { savingsGrowth } from '../../lib/engines/hysa';
import { CONTRIBUTION_OPTIONS, contributionHint, contributionOption } from '../../lib/calc/frequency';
import { CHANGE_SLOTS, COMPOUNDING_OPTIONS, DEFAULT_SAVINGS, SAVINGS_ASSUMPTIONS, SAVINGS_SERIES, savingsChartSvg, savingsSchedule, savingsScheduleConfig, savingsScheduleNotes, savingsView } from '../../lib/calc/savings-view';
import { scheduleTable } from '../../lib/calc/schedule-view';
import { href } from '../../lib/url';
import '../../styles/report.css';

// The example is computed at build time with the same engine and view code the browser
// uses, so the page shows real results without JavaScript.
const computed = savingsGrowth(DEFAULT_SAVINGS);
if (!computed.ok) throw new Error('savings example scenario is invalid');
const view = savingsView(DEFAULT_SAVINGS, computed.value);
const schedule = savingsSchedule(DEFAULT_SAVINGS, computed.value);
const table = scheduleTable(schedule, 'year', savingsScheduleConfig(computed.value));
const chartSvg = savingsChartSvg(DEFAULT_SAVINGS, schedule, 'year', view.summary);
const interval = contributionOption(DEFAULT_SAVINGS.contributionFrequency).interval;
const VERIFIED = 'November 15, 2026';
---
<BaseLayout
  title="High-Yield Savings Calculator"
  description="Project a savings account balance from its advertised APY, with regular deposits, rate changes, daily or monthly compounding, interest credited each month and the APY you actually earn."
>
  <div class="page-head">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Home', path: '' }, { label: 'Calculators', path: 'calculators/' }, { label: 'High-yield savings' }]} />
      <h1>High-yield savings calculator</h1>
      <p class="lead">
        Project a savings balance the way a bank figures interest: a daily rate on each day's
        balance, credited every month, with your deposits and with rate changes along the way.
      </p>
    </div>
  </div>

  <div class="wrap page-body">
    <div class="calc" data-calc="savings" data-state="ok">
      <form class="calc__inputs" novalidate aria-labelledby="sg-inputs-title">
        <h2 class="calc__heading" id="sg-inputs-title">Your savings</h2>
        <p class="calc__note" data-out="shared-note" hidden></p>
        <CalcField id="sg-principal" label="Starting balance" unitLabel="in dollars" kind="money" value="10,000.00" hint="The amount in the account on day one." />
        <CalcField id="sg-apy" label="APY" unitLabel="annual percentage yield, in percent" kind="percent" value="4.5" hint="The annual percentage yield the bank advertises, for example 4.5." />
        <CalcSelect id="sg-compounding" label="Compounding" value={DEFAULT_SAVINGS.compounding} options={COMPOUNDING_OPTIONS.map((o) => ({ value: o.value, label: o.label }))} hint="Your account disclosure says how often interest is compounded and credited." />
        <CalcField id="sg-years" label="Years" kind="whole" value="5" hint="From 1 to 50." />
        <CalcSelect id="sg-contribution-frequency" label="Deposit frequency" value={DEFAULT_SAVINGS.contributionFrequency} options={CONTRIBUTION_OPTIONS.map((o) => ({ value: o.value, label: o.label }))} hint="How often you add money." />
        <div data-contribution>
          <CalcField id="sg-contribution" label="Deposit amount" unitLabel="in dollars" kind="money" value="500.00" hint={contributionHint(DEFAULT_SAVINGS.contributionFrequency, DEFAULT_SAVINGS.timing)} />
        </div>
        <div data-contribution>
          <CalcChoice name="sg-timing" legend="Deposit timing" value={DEFAULT_SAVINGS.timing} options={[{ value: 'end', label: `End of each ${interval}` }, { value: 'start', label: `Start of each ${interval}` }]} />
        </div>
        <fieldset class="calc-account calc-changes">
          <legend>Rate changes <span class="calc-account__optional">(optional)</span></legend>
          <p class="hint">Savings rates change. Enter the month a new APY starts, counting your first month as month 1. Leave a row blank if you do not need it.</p>
          {CHANGE_SLOTS.map((slot) => (
            <div class="calc-account__row">
              <CalcField id={`sg-m${slot}`} label={`Change ${slot}: from month`} kind="whole" value="" hint="" />
              <CalcField id={`sg-r${slot}`} label="New APY" unitLabel="in percent" kind="percent" value="" hint="" />
            </div>
          ))}
        </fieldset>
        <p class="calc__nojs small muted">This calculator needs JavaScript to recalculate. Without it, the results show the example above.</p>
      </form>

      <section class="calc__results" aria-labelledby="sg-results-title">
        <div class="calc__results-head">
          <h2 class="calc__heading" id="sg-results-title">Projected balance</h2>
          <ClaimLabel kind="forecast" />
        </div>
        <div class="calc__values">
          <p class="calc__hero" data-out="final">{view.final}</p>
          <dl class="breakdown">
            <div><dt>Starting balance</dt><dd data-out="principal">{view.breakdown[0]!.value}</dd></div>
            <div><dt>Deposits</dt><dd data-out="contributions">{view.breakdown[1]!.value}</dd></div>
            <div><dt>Interest earned</dt><dd data-out="interest">{view.breakdown[2]!.value}</dd></div>
            <div class="breakdown__total"><dt>Final balance</dt><dd data-out="final-again">{view.final}</dd></div>
          </dl>
          <div class="table-wrap">
            <table class="compare-table rate-table">
              <caption class="vh">Each rate: the advertised APY, the interest rate it implies, and the APY earned each month</caption>
              <thead>
                <tr>
                  <th scope="col">Months</th>
                  <th scope="col" class="num">APY</th>
                  <th scope="col" class="num col-rate">Interest rate</th>
                  <th scope="col" class="num">APY earned</th>
                </tr>
              </thead>
              <tbody data-out="rates">
                {view.rates.map((r) => (
                  <tr><th scope="row">{r.months}</th><td class="num">{r.apy}</td><td class="num col-rate">{r.rate}</td><td class="num">{r.earned}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="calc__summary" data-out="summary">{view.summary}</p>
        </div>
        <p class="calc__invalid" data-out="invalid">Results are hidden until the highlighted entries are fixed.</p>
        <p class="calc__incomplete" data-out="incomplete">Enter your own dollar amounts to see results.</p>
        <p class="vh" data-out="status" role="status" aria-live="polite"></p>
        <ShareExport idPrefix="sg" />
        <p class="small muted">A hypothetical projection, not a prediction. Savings rates change. <a href={href('disclaimer/')}>Disclaimer</a>.</p>
      </section>
    </div>

    <div class="calc-sticky" data-sticky aria-hidden="true">
      <span>Projected balance</span>
      <strong data-out="final-sticky">{view.final}</strong>
    </div>

    <ScheduleView id="sg-schedule" heading="Balance and schedule" series={SAVINGS_SERIES} svg={chartSvg} table={table} notes={savingsScheduleNotes(DEFAULT_SAVINGS, 'year')} chartHelp="the balance" />

    <div class="prose calc-notes">
      <h2>The APY, the interest rate and how interest is credited</h2>
      <p>
        A bank advertises a savings account by its annual percentage yield: "a percentage rate
        reflecting the total amount of interest paid on an account, based on the interest rate
        and the frequency of compounding for a 365-day period." <span class="cite">12 CFR 1030.2(c)</span> Behind
        it are three things the account disclosure states:
      </p>
      <ul>
        <li><strong>The interest rate</strong>, which does not include compounding. Banks must figure interest "for each day" using "a daily rate of at least 1/365 of the interest rate." <span class="cite">12 CFR 1030.7(a)(1)</span></li>
        <li><strong>How often interest is compounded and credited.</strong> The rules do "not require institutions to compound or credit interest at any particular frequency," but the disclosure must state it. <span class="cite">12 CFR 1030.7(b); 1030.4(b)(2)(i)</span></li>
        <li><strong>Whether the rate can change.</strong> For a variable-rate account the disclosure must say that "the interest rate and annual percentage yield may change." <span class="cite">12 CFR 1030.4(b)(1)(ii)</span></li>
      </ul>
      <p>
        This calculator starts from the advertised APY and works out the interest rate that
        gives exactly that APY under the compounding you choose. The table of rates shows both.
      </p>

      <h2>The APY you actually earn</h2>
      <p>
        Statements show an "annual percentage yield earned," which "reflects the relationship
        between the amount of interest actually earned on the consumer's account during the
        statement period and the average daily balance in the account for the statement
        period." <span class="cite">12 CFR part 1030, appendix A, part II</span> It moves around
        the advertised APY from month to month for three reasons: interest is rounded to the
        cent each month; with monthly compounding a short month like February earns a slightly
        higher yield than a long one; and deposits made during a month count only for the days
        they were in the account.
      </p>
      <p>
        As the official commentary requires for monthly statements on an account that
        compounds daily and credits monthly, the average balance here leaves out interest
        accrued but not yet credited, and the interest is the amount actually paid, rounded to
        the cent. <span class="cite">Supplement I to part 1030, appendix A, part II.A, comments 1 and 2</span>
      </p>

      <h2>Assumptions</h2>
      <p>
        Regulation DD leaves several conventions to each bank. This calculator picks one for
        each, labeled as an assumption below; your bank's own disclosure may differ.
      </p>
      <ul>
        {SAVINGS_ASSUMPTIONS.map((a) => <li>{a}</li>)}
      </ul>

      <h2>How this is calculated</h2>
      <p>For an advertised APY, the interest rate r is:</p>
      <ul>
        <li>Daily compounding: <code>r = 365 × [(1 + APY)<sup>1/365</sup> − 1]</code>.</li>
        <li>Monthly compounding: the rate for which <code>(1 + r × 31/365) × (1 + r × 28/365) × … × (1 + r × 31/365) = 1 + APY</code>, one factor per month of the year, found numerically.</li>
      </ul>
      <p>
        Each month, with daily compounding, the interest is the balance times
        <code>(1 + APY)<sup>days/365</sup> − 1</code>, plus the same for each deposit over the
        days it was in the account. With monthly compounding it is the sum of each day's
        balance times <code>r/365</code>. The interest is rounded to the cent and credited. The
        calculation is checked against an independent implementation that uses exact decimal
        arithmetic. See the <a href={href('methodology/')}>Methodology</a>, and the <a href={href('calculators/compound-interest/')}>compound interest calculator</a> for
        the textbook model that gives every period the same share of the rate.
      </p>

      <h2>Sources</h2>
      <ul class="small">
        <li>12 CFR part 1030 (Regulation DD, Truth in Savings), sections 1030.2, 1030.4, 1030.7 and appendix A. Electronic Code of Federal Regulations, eCFR, text as of November 1, 2026. Verified {VERIFIED}.</li>
      </ul>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/calc/savings';
</script>
